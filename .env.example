# ==============================================================================
# LearnMate AI - Environment Variables Template
# Copy this file to .env and configure your keys.
# All paths default automatically to your project root and data/ directories.
# ==============================================================================

# Active LLM Configuration (Google Gemini Free Tier)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
ENABLE_MODEL_FALLBACK=true
LLM_MODE=mock
LLM_TIMEOUT=30
LLM_MAX_OUTPUT_TOKENS=1500

# Optional Inactive Provider (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
OPENAI_MAX_OUTPUT_TOKENS=1500

# RAG Context & Retrieval Budget Parameters
RAG_TOP_K=10
RAG_CANDIDATE_TOP_K=10
RAG_MAX_CONTEXT_CHUNKS=6
RAG_MAX_CONTEXT_TOKENS=1600

# Whisper Speech-to-Text Model Configuration
WHISPER_MODEL_SIZE=base

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=1
EMBEDDING_MAX_LENGTH=512
EMBEDDING_PASSAGE_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX="query: "

# Vector Store Engine ('auto', 'faiss', 'numpy')
VECTOR_STORE_BACKEND=auto

# Optional Directory Overrides (defaults to local relative paths if unset)
# DATA_DIR=data
# VIDEOS_DIR=data/videos
# AUDIO_DIR=data/audio
# TRANSCRIPTS_DIR=data/transcripts
# CHUNKS_DIR=data/chunks
# VECTOR_STORE_DIR=data/vector_store
# FEEDBACK_DIR=data/feedback
